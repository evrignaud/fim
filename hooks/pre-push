#
# Verify before pushing, which is what the hosted builds used to do after pushing.
#
# Enable it with:
#     git config core.hooksPath hooks
#
# Disable it again with:
#     git config --unset core.hooksPath
#
# Skip it for one push with `git push --no-verify` when you already know the build is good.
#-----------------------------------------------------------------------------------------------------------------------

echo "pre-push: running './gradlew check'. Use --no-verify to skip it."

if [ "$OS" = "Windows_NT" ]; then
    ./gradlew.bat check --console=plain
else
    ./gradlew check --console=plain
fi

status=$?
if [ ${status} -ne 0 ]; then
    echo ""
    echo "pre-push: the build failed, so nothing was pushed."
    echo "pre-push: fix it, or push with --no-verify if you know what you are doing."
    exit ${status}
fi

#-----------------------------------------------------------------------------------------------------------------------
